// Función serverless de Vercel. Se publica automáticamente en /api/recommend
// porque está dentro de la carpeta /api del proyecto.
//
// Necesita la variable de entorno ANTHROPIC_API_KEY configurada en Vercel
// (Project Settings → Environment Variables). La API key se consigue gratis
// con una cuenta en https://console.anthropic.com

module.exports = async (req, res) => {
  if (req.method !== 'POST') {
    res.status(405).json({ error: 'Método no permitido' });
    return;
  }

  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) {
    res.status(500).json({ error: 'Falta configurar ANTHROPIC_API_KEY en Vercel' });
    return;
  }

  const { terreno, posicion, prioridad, talle } = req.body || {};

  if (!terreno || !posicion || !prioridad || !talle) {
    res.status(400).json({ error: 'Faltan datos del cuestionario' });
    return;
  }

  const prompt = `Sos un asesor experto en botines de fútbol. Un jugador respondió este cuestionario:
- Terreno de juego: ${terreno}
- Posición: ${posicion}
- Prioridad principal: ${prioridad}
- Talle: ${talle}

Recomendale un TIPO de botín (no una marca ni un modelo comercial puntual, sino una característica técnica: ej. "corte bajo con tapón cónico", "suela multitaco textil", "entresuela reforzada", etc.) que tenga sentido para su terreno, posición y prioridad.

Respondé ÚNICAMENTE con un objeto JSON válido, sin texto antes ni después, con este formato exacto:
{"nombre": "Nombre corto del tipo de botín (máximo 6 palabras)", "descripcion": "Explicación de 1 a 2 frases de por qué le conviene, mencionando su terreno y su prioridad"}`;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-5',
        max_tokens: 300,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      console.error('Error de la API de Anthropic:', errText);
      res.status(502).json({ error: 'Error al generar la recomendación' });
      return;
    }

    const data = await response.json();
    const textBlock = data.content.find((b) => b.type === 'text');
    const raw = textBlock ? textBlock.text.trim() : '';

    // Limpia posibles backticks de markdown antes de parsear
    const clean = raw.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(clean);

    res.status(200).json(parsed);
  } catch (err) {
    console.error('Error en /api/recommend:', err);
    res.status(500).json({ error: 'No se pudo generar la recomendación' });
  }
};
